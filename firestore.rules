rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The pandit is the one hardcoded Gmail account. Everyone else is a customer.
    function isPandit() {
      return signedIn()
        && request.auth.token.email == 'pawanstar72926@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // The account the Razorpay API routes (src/app/api) sign in as after verifying a payment.
    function isPaymentsServer() {
      return signedIn() && request.auth.uid == 'jeTrjyHUGoW6rSO3lQ0NWivEFUA3';
    }

    // Active 24-hour chat pass, granted after a verified Razorpay payment.
    function hasPass(uid) {
      return exists(/databases/$(database)/documents/passes/$(uid))
        && get(/databases/$(database)/documents/passes/$(uid)).data.validUntil > request.time;
    }

    match /settings/desk {
      allow read: if signedIn();
      allow write: if isPandit()
        && request.resource.data.keys().hasOnly(['online', 'waitMinutes'])
        && request.resource.data.online is bool
        && request.resource.data.waitMinutes in [2, 5, 10];
    }

    match /passes/{uid} {
      allow read: if isPandit() || isPaymentsServer() || (signedIn() && request.auth.uid == uid);
      allow create, update: if (isPandit() || isPaymentsServer())
        && request.resource.data.keys().hasOnly(['validUntil', 'updatedAt'])
        && request.resource.data.validUntil is timestamp
        && request.resource.data.validUntil <= request.time + duration.value(49, 'h');
      allow delete: if isPandit();
    }

    // One document per verified Razorpay payment; its id is the Razorpay payment id.
    match /payments/{paymentId} {
      allow read: if isPandit() || isPaymentsServer()
        || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if isPaymentsServer()
        && request.resource.data.keys().hasOnly(['customerUid', 'amount', 'orderId', 'paymentId', 'provider', 'createdAt'])
        && request.resource.data.paymentId == paymentId
        && request.resource.data.amount == 49
        && request.resource.data.createdAt == request.time;
      allow delete: if isPandit();
    }

    match /chats/{chatId} {
      function isCustomer() {
        return signedIn() && resource.data.customerUid == request.auth.uid;
      }

      allow read, delete: if isPandit() || isCustomer();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'customerUid', 'customerName', 'customerPhoto', 'panditId', 'status',
          'requestedAt', 'acceptBy', 'acceptedAt', 'expiresAt', 'lastText', 'lastAt'
        ])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.panditId in ['pandit-raghav', 'pandit-devesh', 'maulana-imran', 'maulana-abdul']
        && request.resource.data.status == 'waiting'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.lastAt == request.time
        && request.resource.data.acceptBy is timestamp
        && request.resource.data.acceptBy <= request.time + duration.value(11, 'm')
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');

      allow update: if !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['customerUid', 'panditId', 'requestedAt', 'acceptBy', 'expiresAt'])
        && (
          // The pandit can accept only inside the waiting window.
          (isPandit() && (
            request.resource.data.status != 'live'
            || resource.data.status == 'live'
            || request.time < resource.data.acceptBy
          ))
          // The customer can only cancel/end, or update the preview line.
          || (isCustomer()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastText', 'lastAt'])
            && request.resource.data.status in [resource.data.status, 'ended'])
        );

      match /messages/{messageId} {
        function chat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function member() {
          return isPandit() || (signedIn() && chat().customerUid == request.auth.uid);
        }

        allow read, delete: if member();

        allow create: if member()
          && chat().status == 'live'
          && request.time < chat().expiresAt
          && request.resource.data.keys().hasOnly(['from', 'kind', 'text', 'image', 'createdAt', 'expiresAt'])
          && ((isPandit() && request.resource.data.from == 'pandit')
            || (!isPandit() && request.resource.data.from == 'customer'
              // First 2 minutes of every chat are free; after that a pass is required.
              && (request.time < chat().acceptedAt + duration.value(2, 'm')
                || hasPass(request.auth.uid))))
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt == chat().expiresAt
          && (
            (request.resource.data.kind == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000)
            || (request.resource.data.kind == 'photo'
              && request.resource.data.image is string
              && request.resource.data.image.size() < 900000)
          );
      }
    }
  }
}
