# Copy to .env.local and fill in. Values come from Firebase console > Project settings > Your apps > Web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firebase console > Authentication > Sign-in method > Google > Web SDK configuration > Web client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only: OAuth iOS client ID, and its reversed form as the URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.

# Comma-separated emails allowed to accept and answer chats.
EXPO_PUBLIC_GUIDE_EMAILS=

# Where the API routes are deployed (eas deploy), e.g. https://astrotalk.expo.app
EXPO_PUBLIC_API_URL=

# --- Server only (put these in .env, never with EXPO_PUBLIC_) ---
# Razorpay dashboard > Account & Settings > API keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Firebase email/password account the payment server signs in as. Its uid goes in firestore.rules.
PAYMENTS_BOT_EMAIL=
PAYMENTS_BOT_PASSWORD=
