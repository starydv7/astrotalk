{
  "expo": {
    "name": "AstroTalk",
    "slug": "astrotalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "astrotalk",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07060F",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.starydv7.astrotalk",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "AstroTalk uses your photos so you can send a picture in a live chat."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07060F",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.starydv7.astrotalk"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07060F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "AstroTalk uses your photos so you can send a picture in a live chat.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f201589b-8f08-4d77-a889-ad087c37f549"
      }
    }
  }
}
